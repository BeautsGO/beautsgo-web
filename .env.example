APP_DEBUG = true

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

# 数据库连接（与 beautsgo_api 共享同一个 RDS，建议使用只读账号）
[DATABASE]
TYPE     = mysql
HOSTNAME = your-rds-host.mysql.rds.aliyuncs.com
DATABASE = your_database_name
USERNAME = your_readonly_user
PASSWORD = your_password
HOSTPORT = 3306
CHARSET  = utf8mb4
PREFIX   = fcam_
DEBUG    = false

# 外部 API 配置（保留给将来调外部服务，如地图/IM/支付）
[API]
BASE_URL = https://api.beautsgo.com/api
TIMEOUT  = 5
CONNECT_TIMEOUT = 2

[SEO]
SITE_URL     = https://i.beautsgo.com
DEFAULT_LANG = zh-Hans

[CACHE]
DRIVER = file

[REDIS]
HOST     = 127.0.0.1
PORT     = 6379
PASSWORD =
SELECT   = 0
