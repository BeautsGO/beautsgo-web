{
    "name": "beautsgo/web",
    "description": "BeautsGO SSR Frontend - PHP 7.2.5+ / ThinkPHP 6 SSR reconstruction of the UniApp H5 i.beautsgo.com for SEO",
    "type": "project",
    "license": "Proprietary",
    "require": {
        "php": ">=7.2.5",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "topthink/framework": "~6.0.0",
        "topthink/think-view": "^1.0"
    },
    "require-dev": {
        "symfony/var-dumper": "^4.2 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app"
        },
        "files": [
            "app/common.php"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "think": {
            "services": []
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
